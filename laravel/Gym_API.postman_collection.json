{
	"info": {
		"_postman_id": "a91b4528-76c2-48f0-b992-80512f45c812",
		"name": "Gym API (Laravel)",
		"description": "Postman collection for Gym Management API (Coaches, Members, Subscriptions, Classes, Registrations).\n\nAll list endpoints are filtered + paginated:\n- `page` (default {{page}}) and `per_page` (1-100, default 15) - enabled on every list request.\n- Optional filters are listed in each request description - tick them in Params to enable.\n- Rows are returned under `data`, next to `total`, `per_page`, `last_page` and `next_page_url`.\n\nPage 2 with 10 per page: `GET /api/members?per_page=10&page=2`\nOr just change the `page` collection variable to 2 and hit Send.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		},
		{
			"key": "per_page",
			"value": "10",
			"type": "string"
		},
		{
			"key": "page",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Pagination Examples",
			"description": "Page 2 with 10 items per page = `?per_page=10&page=2`.\n\n`GET /api/members?per_page=10&page=2`\n\nThe response contains `total`, `per_page`, `last_page`, `current_page` and `next_page_url`. If `next_page_url` is `null`, you are on the last page. `next_page_url` already keeps your filters and per_page, so you can copy it as-is for the next page.",
			"item": [
				{
					"name": "Members - page 1, 10 per page",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"description": "First page. Rows are in `data`; `total` tells you how many there are overall.",
						"url": {
							"raw": "{{base_url}}/members?per_page=10&page=1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"members"
							],
							"query": [
								{
									"key": "per_page",
									"value": "10"
								},
								{
									"key": "page",
									"value": "1"
								}
							]
						}
					}
				},
				{
					"name": "Members - page 2, 10 per page",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"description": "Second page: same per_page, page=2. Works the same for /coaches, /subscriptions, /classes and /registrations.",
