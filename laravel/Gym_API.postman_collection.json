		{
			"name": "Auth",
			"description": "JWT authentication. Login once, then every other request sends `Authorization: Bearer {{token}}`.",
			"item": [
				{
					"name": "Register (client)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"description": "Self-registration always creates a **client** and an empty member profile for them. Sending `role` in the body has no effect.\n\nResponse: 201 + access_token (also saved to `{{token}}` by the test script).",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"New Client\",\n    \"email\": \"new.client@gym.test\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"phone\": \"+380500000000\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						}
					},
					"event": {
						"listen": "test",
						"script": {
							"type": "text/javascript",
							"exec": [
								"const body = pm.response.json();",
								"if (body.access_token) {",
								"    pm.collectionVariables.set('token', body.access_token);",
								"    console.log('token saved to {{token}}');",
								"}"
							]
						}
					}
				},
				{
					"name": "Login as Admin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"description": "Returns `access_token` (JWT). The test script stores it in the collection variable `{{token}}`, which the collection-level Bearer auth uses for every other request.\n\nDemo accounts (password: `password`):\n- admin@gym.test (admin)\n- manager@gym.test (manager)\n- client@gym.test (client)\n\nLogin is throttled to 5 requests per minute.",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@gym.test\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"event": {
						"listen": "test",
						"script": {
							"type": "text/javascript",
							"exec": [
								"const body = pm.response.json();",
								"if (body.access_token) {",
								"    pm.collectionVariables.set('token', body.access_token);",
								"    console.log('token saved to {{token}}');",
								"}"
							]
						}
					}
				},
